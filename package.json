{
  "name": "bugsite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "prettier --write src api server vite.config.js eslint.config.js package.json vercel.json .prettierrc.json",
    "format:check": "prettier --check src api server vite.config.js eslint.config.js package.json vercel.json .prettierrc.json",
