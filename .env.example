# Site origin. No trailing path. For local npm run dev use http://localhost:5173
APP_URL=http://localhost:5173

# Discord Developer Portal -> OAuth2
# Register EXACT redirect: https://your-domain/api/auth?action=callback
# Local redirect: http://localhost:5173/api/auth?action=callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Comma-separated user IDs. These users have access without a server role.
DISCORD_ADMIN_USER_IDS=
# Either role grants access to members of DISCORD_GUILD_ID.
DISCORD_ADMIN_ROLE_ID_1=
DISCORD_ADMIN_ROLE_ID_2=
DISCORD_TEST_WEBHOOK_URL=

# Cloudinary Console. Secret is SERVER ONLY, never prefix it with VITE_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis REST credentials (read/write token).
# Durable content, sessions, test attempts and shared rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use a separate database or prefix for development / preview / production.
REDIS_KEY_PREFIX=butterfly-dev
